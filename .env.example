# Copy this file to .env and fill it locally. Never commit .env or real secrets.
APP_ENV=development
LOG_LEVEL=INFO
OPERATING_MODE=adsb

# Existing MySQL host only; use a provisioned ADS-B schema and least-privilege app account.
DB_HOST=192.168.1.50
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=5

# Generate a private token with: openssl rand -hex 32. Use the same value for both Compose services.
RADIO_CONTROL_TOKEN=

# Required when OPERATING_MODE=adsb. Compose's receiver controller exposes readsb at this name.
RECEIVER_ID=
RECEIVER_MODE=
RECEIVER_HOST=
RECEIVER_PORT=
DECODER_NAME=
DECODER_INPUT_MODE=
DECODER_OUTPUT_MODE=
DECODER_ENDPOINT=tcp://radio-control:30006
DECODER_VERSION=

# Set in production after owner decisions and frontend origin are known.
API_BIND_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=
FLIGHT_SESSION_SILENCE_SECONDS=
AIRCRAFT_STALE_AFTER_SECONDS=
OBSERVATION_RETENTION_DAYS=
